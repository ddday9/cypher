# Domain of this server (A record pointing here). Required.
CYPHER_DOMAIN=example.com
# Email for Let's Encrypt notices (optional).
CYPHER_EMAIL=
# 1 = this server refuses Russian sites and IPs (exit servers only).
CYPHER_BLOCK_RU=0
# Relay mode (server in Russia): a cypher:// link of a user on the exit server.
CYPHER_UPSTREAM=
